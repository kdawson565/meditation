# Optional. Without these, Ballast runs fully local (data stays in this browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used by DELETE /api/account to remove the auth user. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Phase 2 (server only)
ANTHROPIC_API_KEY=

# Phase 3: push reminders (server only except the public key). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any long random string. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
